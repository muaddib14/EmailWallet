# Neon Postgres connection string.
# Get this from your Neon project dashboard (or the Vercel Neon integration,
# which injects it automatically for you). Copy this file to .env.local and
# fill in the real value — .env.local is gitignored.
DATABASE_URL="postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# Dedicated wallet the app uses to send official messages (welcome mail on
# first login). Generate one with:
#   node -e "console.log(require('viem/accounts').generatePrivateKey())"
# Keep it secret — whoever holds it can sign mail that looks like it's from
# "Quil Team."
SYSTEM_WALLET_PRIVATE_KEY="0x..."

# OpenRouter API key for the AI inbox summary feature (Settings -> not user
# facing; this is server-side only, users never enter their own key).
# Get a free key at https://openrouter.ai/keys — no card required for the
# `:free` models the app calls (src/lib/aiServer.ts). If unset, the AI
# summary button just shows "not configured on this server yet."
OPENROUTER_API_KEY="sk-or-v1-..."

# Vercel Blob token for encrypted file attachments (Settings -> not user
# facing; files are encrypted in the browser before upload, the server only
# sees ciphertext). Get one from your Vercel project dashboard under Storage.
# If unset, the attach button is hidden and uploads return 503.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
